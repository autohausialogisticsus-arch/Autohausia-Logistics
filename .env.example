# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase hosts Postgres, which is what Prisma uses. Use the CONNECTION POOLER
# string (port 6543), NOT the direct string (port 5432), so serverless
# functions don't exhaust connections. In the Supabase dashboard:
#   Project Settings → Database → Connection string → "Transaction pooler"
# Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── Site ─────────────────────────────────────────────────────────────────────
# Live site host (absolute host used for canonical URLs, sitemap, robots, OG,
# and Organization JSON-LD). Set to your Vercel domain, e.g. https://yourdomain.com
SITE_URL="https://yourdomain.com"

# Public business contact info (NEXT_PUBLIC_ so the values are inlined in client
# components too — they are public, not secrets).
NEXT_PUBLIC_COMPANY_NAME="Autohausia Logistic LLC"
NEXT_PUBLIC_CONTACT_EMAIL="Autohausialogistics.us@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE_TEL="+13194937195"
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="(319) 493-7195"

# ── Email (Resend) — new-carrier-application notifications ──────────────────
# Resend sends the notification (with the uploaded documents attached) to
# APPLICATION_NOTIFY_TO — set that to your Gmail address.
#
# Setup (5 min):
#   1. Create an account at https://resend.com (free) with the SAME email you
#      want to receive notifications to (your Gmail).
#   2. Get an API key: https://resend.com/api-keys → create key → paste below.
#   3. Sandbox rule: while unverified, RESEND_FROM must be "onboarding@resend.dev"
#      and emails can ONLY be sent to the address you signed up with. Once you
#      verify a custom domain you can set RESEND_FROM like:
#      "Autohausia <apply@yourdomain.com>".
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
APPLICATION_NOTIFY_TO="you@gmail.com"

# ── Document uploads (carrier application) ──────────────────────────────────
# S3-compatible storage. Works with AWS S3, Cloudflare R2, or Supabase Storage
# (which exposes an S3-compatible endpoint). Uploads are optional: if these are
# unset, carriers can still submit without documents.
#
# For Supabase Storage:
#   S3_REGION="<your-region>"                          # e.g. us-east-1
#   S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
#   S3_BUCKET="<bucket-name>"
#   S3_ACCESS_KEY_ID  /  S3_SECRET_ACCESS_KEY  = project API keys from
#     Project Settings → API.
S3_REGION="auto"
S3_ENDPOINT=""          # leave blank for AWS; R2/Supabase need this
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public base URL for uploaded documents so the notification email can link
# them. For Supabase Storage use:
#   https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# For AWS/R2 leave blank to fall back to the S3 endpoint.
S3_PUBLIC_BASE_URL=""

# ── Admin ───────────────────────────────────────────────────────────────────
# Password to access the private leads dashboard at /admin.
# Keep it strong (8+ chars). Leave empty to disable the dashboard entirely.
ADMIN_PASSWORD=""